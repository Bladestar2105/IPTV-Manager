# Server Configuration
PORT=3000
# NODE_ENV=production
# DATA_DIR=./data

# Reverse Proxy Configuration
# TRUST_PROXY=true

# Security Configuration
# JWT_SECRET: Secret used for signing JSON Web Tokens. Change this to a strong random string.
JWT_SECRET=your_jwt_secret_here
# JWT_EXPIRES_IN: Token expiration time (e.g., 24h, 7d).
JWT_EXPIRES_IN=24h
# BCRYPT_ROUNDS: Cost factor for password hashing (higher is safer but slower).
BCRYPT_ROUNDS=10

# Encryption Key for Provider Passwords
# Must be a 32-byte (64 character) hex string.
# If not set, a key is generated in secret.key.
ENCRYPTION_KEY=

# CORS Configuration
# Comma-separated list of allowed origins (e.g., https://my-player.com,https://other.com)
# Leave empty to block cross-origin requests (default secure behavior).
# Set to * to allow all (not recommended).
ALLOWED_ORIGINS=

# Optional shared stream tracking
# When configured and reachable, active stream state is stored in Redis.
# REDIS_URL=redis://localhost:6379

# Rate Limit Configuration
# General API, Xtream API, XMLTV, and playlist endpoint requests per IP/window.
API_RATE_LIMIT_MAX=1000
API_RATE_LIMIT_WINDOW_MS=60000
# Login and other authentication-sensitive endpoint requests per IP/window.
AUTH_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
# Client log submissions per IP/window.
CLIENT_LOG_RATE_LIMIT_MAX=120
CLIENT_LOG_RATE_LIMIT_WINDOW_MS=3600000

# Stream Session Cleanup
STREAM_MAX_AGE_MS=86400000
STREAM_INACTIVITY_TIMEOUT_MS=120000

# Optional MaxMind GeoLite2 updates
# MAXMIND_LICENSE_KEY=

# Initial Admin User Setup
# If set, this password will be used for the default 'admin' user created on first run.
# Otherwise, a random password will be generated and printed to the console.
INITIAL_ADMIN_PASSWORD=

# Optional personal ChatGPT (Codex) connection
# Disabled by default. When enabled, each user and administrator links their own
# ChatGPT account through the official Codex sign-in; no OpenAI platform API key
# is used. The connection type is offered only when the server can prove that
# the Codex runtime is contained by an operating-system sandbox.
# AI_CODEX_ENABLED=false
# Path to the pinned Codex CLI (tested: 0.154.0, accepted: >=0.154.0 <0.156.0).
# AI_CODEX_BIN=codex
# Root for per-identity runtime directories (default: $DATA_DIR/ai-codex).
# AI_CODEX_RUNTIME_DIR=
# Isolation backend: auto | bwrap | sandbox-exec | none.
# AI_CODEX_SANDBOX=auto
# Accept a development-grade backend (macOS sandbox-exec). Not for hosted
# multi-user operation.
# AI_CODEX_ALLOW_DEV_SANDBOX=false
# Accept one exact Codex version outside the tested range after validating it.
# Must match the reported version exactly, including a prerelease suffix.
# AI_CODEX_VERSION_OVERRIDE=
