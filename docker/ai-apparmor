# Derived from Moby profiles/apparmor/template.go, Apache-2.0.
# https://github.com/moby/profiles/tree/61eaf32614c7c71b60bd8927d3e6a4ffc8ff1f31
# Changes: named profile; allow bubblewrap namespace/mount setup; keep Docker denials.
abi <abi/3.0>,
#include <tunables/global>

profile iptv-manager-ai flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  network,
  deny network alg,
  deny network vsock,
  capability,
  file,
  umount,
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (send,receive) peer=iptv-manager-ai,
  ptrace (trace,tracedby,read,readby) peer=iptv-manager-ai,

  # Bubblewrap mounts only synthetic filesystems and binds existing paths.
  mount fstype=tmpfs,
  mount fstype=devpts,
  mount options=(silent,rw,bind),
  mount options=(silent,rw,rbind),
  mount options=(silent,rw,make-rslave),
  mount options=(silent,rw,make-rprivate),
  remount options in (ro,rw,bind,nosuid,nodev,noexec,silent,relatime,strictatime,noatime,nodiratime),
  pivot_root,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,
}
